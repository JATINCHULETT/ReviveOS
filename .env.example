# ==========================================
# REVIVEOS CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# GENERAL
# ------------------------------------------
APP_ENV=local
PORT=8080

# ------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------
# Required. Connection string for PostgreSQL database.
# Local Docker example: postgres://postgres:postgres@localhost:5432/reviveos?sslmode=disable
# Production example: Supabase PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reviveos?sslmode=disable

# ------------------------------------------
# REDIS
# ------------------------------------------
# Required. Connection string for Redis.
# Used for Asynq (Go Background jobs), Rate Limiting, Idempotency.
# Local Docker example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# SUPABASE AUTHENTICATION
# ------------------------------------------
# Required. Used for tenant authentication. 
# Get these from your Supabase project settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# ------------------------------------------
# AI PROVIDER (Local/Production)
# ------------------------------------------
# Required for ML inference/LLM recommendations.
# Default uses local Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# ------------------------------------------
# RAZORPAY TEST MODE
# ------------------------------------------
# Optional for local, required for Razorpay ingestion.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ------------------------------------------
# RECOVERY POLICY DEFAULTS
# ------------------------------------------
MAX_RETRY_ATTEMPTS=3
MAX_CONTACT_ATTEMPTS=2
RECOVERY_CONFIDENCE_THRESHOLD=0.75
HIGH_VALUE_APPROVAL_THRESHOLD=50000

# ------------------------------------------
# FRONTEND API COMMUNICATION
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------
# NOTIFICATION (Resend for Email)
# ------------------------------------------
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@revive-os.me

# ------------------------------------------
# B2B RECEIVABLES CHASER
# ------------------------------------------
DUNNING_ENABLED=true
DUNNING_DEFAULT_GRACE_PERIOD_DAYS=3

# ------------------------------------------
# HINGLISH VOICE RECOVERY (Twilio Telephony)
# ------------------------------------------
VOICE_PROVIDER=twilio               # 'twilio' or 'local' (offline simulator)

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VOICE_CALLER_ID=your-twilio-phone-number


# ------------------------------------------
# PROMISE-TO-PAY (PTP) TRACKER
# ------------------------------------------
PTP_AUTO_REMINDER_HOURS_BEFORE=24
PTP_MAX_EXTENSIONS=2

# ------------------------------------------
# CHECKOUT DROP-OFF RECOVERY
# ------------------------------------------
CHECKOUT_DROPOFF_TIMEOUT_MINUTES=15
CHECKOUT_DROPOFF_DISPATCH_CHANNEL=email,whatsapp

