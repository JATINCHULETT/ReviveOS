# ==========================================
# REVIVEOS CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# GENERAL
# ------------------------------------------
APP_ENV=local
PORT=8080

# ------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------
# Required. Connection string for PostgreSQL database.
# Local Docker example: postgres://postgres:postgres@localhost:5432/reviveos?sslmode=disable
# Production example: Supabase PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reviveos?sslmode=disable

# ------------------------------------------
# REDIS
# ------------------------------------------
# Required. Connection string for Redis.
# Used for Asynq (Go Background jobs), Rate Limiting, Idempotency.
# Local Docker example: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# SUPABASE AUTHENTICATION
# ------------------------------------------
# Required. Used for tenant authentication. 
# Get these from your Supabase project settings -> API.
SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# ------------------------------------------
# AI PROVIDER (Local/Production)
# ------------------------------------------
# Required for ML inference/LLM recommendations.
# Default uses local Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# ------------------------------------------
# RAZORPAY TEST MODE
# ------------------------------------------
# Optional for local, required for Razorpay ingestion.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ------------------------------------------
# RECOVERY POLICY DEFAULTS
# ------------------------------------------
MAX_RETRY_ATTEMPTS=3
MAX_CONTACT_ATTEMPTS=2
RECOVERY_CONFIDENCE_THRESHOLD=0.75
HIGH_VALUE_APPROVAL_THRESHOLD=50000

# ------------------------------------------
# FRONTEND API COMMUNICATION
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
